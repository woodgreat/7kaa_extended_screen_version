AM_CPPFLAGS = \
	-DPACKAGE_DATA_DIR=\"$(pkgdatadir)\" \
	-DLOCALE_DIR=\"$(localedir)\"

AM_CXXFLAGS = $(GLOBAL_CFLAGS) $(SDL_CFLAGS)
AM_LDFLAGS = $(GLOBAL_LDFLAGS)
